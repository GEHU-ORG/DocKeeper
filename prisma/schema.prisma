generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  universityId  String?
  university    University? @relation(fields: [universityId], references: [id])
  accounts      Account[]
  sessions      Session[]
  fileOwnerships FileOwnership[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model University {
  id          String       @id @default(cuid())
  name        String       @unique  // e.g., "GEHU", "IIT Delhi", "DU"
  slug        String       @unique  // e.g., "gehu", "iit-delhi", "du"
  fullName    String?      // e.g., "Graphic Era Hill University"
  logo        String?      // URL to logo
  githubOrg   String?      // GitHub org name for data sync
  courses     Course[]
  users       User[]
  createdAt   DateTime     @default(now())
}

model Course {
  id           String       @id @default(cuid())
  name         String       // e.g., "B.Tech", "BCA", "MBA"
  universityId String
  university   University   @relation(fields: [universityId], references: [id])
  departments  Department[]

  @@unique([name, universityId])
}

model Department {
  id       String     @id @default(cuid())
  name     String     // e.g., "Computer Science Engineering (CSE)", "General", "Finance"
  courseId String
  course   Course     @relation(fields: [courseId], references: [id])
  semesters Semester[]

  @@unique([name, courseId])
}

model Semester {
  id           String     @id @default(cuid())
  name         String     // e.g., "Semester 1", "sem 3"
  number       Int        // 1, 2, 3...
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  subjects     Subject[]
}

model Subject {
  id          String     @id @default(cuid())
  name        String     // e.g., "operating systems", "dbms"
  semesterId  String
  semester    Semester   @relation(fields: [semesterId], references: [id])
  syllabus    String?    @db.Text
  pyqAnalysis String?    @db.Text
  studyNotes  StudyNote[]
}

model StudyNote {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  marks       Int
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([subjectId, marks])
}

model FileOwnership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filePath  String   @unique
  createdAt DateTime @default(now())
}
